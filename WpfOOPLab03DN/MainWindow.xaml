<Window x:Class="WpfOOPLab03DN.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfOOPLab03DN"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">

    <Window.Resources>
        <Style x:Key="BtnStyle" TargetType="Button">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="10,0,10,0"/>
            <Setter Property="Margin" Value="10"/>
        </Style>
        <Style x:Key="StckPnl_Horizantal" TargetType="StackPanel">
            <Setter Property="Orientation" Value="Horizontal"/>
        </Style>
        <Style x:Key="Prop_Style" TargetType="TextBox">
            <Setter Property="Padding" Value="10"/>
        </Style>
    </Window.Resources>
    
    <DockPanel LastChildFill="False">
        <StackPanel Style="{StaticResource StckPnl_Horizantal}" DockPanel.Dock="Top">
            <TextBox x:Name="TextBoxNote" Style="{StaticResource Prop_Style}" Width="200">Название специальности врача</TextBox>
            <TextBox x:Name="TextBoxDctrName" Style="{StaticResource Prop_Style}" Width="200">Имя врача</TextBox>
            <TextBox x:Name="TextBoxPtntName" Style="{StaticResource Prop_Style}" Width="200">Имя пациента</TextBox>
            <DatePicker x:Name="DatePickerNote"></DatePicker>
            <Button Style="{StaticResource BtnStyle}" Content="Ввод" Click="BtnInPut_Click"/>
        </StackPanel>
        <StackPanel DockPanel.Dock="Left" Orientation="Vertical">

            <Button Style="{StaticResource BtnStyle}" Content="Вывести" Click="BtnOutPut_Click"/>
            <Button Style="{StaticResource BtnStyle}" Content="Удалить" Click="BtnDelNote_Click"/>
            <TextBox x:Name="DelChng_TextBox">номер записи</TextBox>
            <Button Style="{StaticResource BtnStyle}" Content="Сортировать" Click="BtnSortNotes_Click"/>

        </StackPanel>
        <TextBlock x:Name="OutPutTextBlock" DockPanel.Dock="Left" Width="500" TextWrapping="Wrap" AllowDrop="True"></TextBlock>
    </DockPanel>
</Window>
